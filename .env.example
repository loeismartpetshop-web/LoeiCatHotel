# Public client configuration
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# LIFF ID - Login Cat Hotel > LIFF tab (format: {channelId}-{random})
PUBLIC_LINE_LIFF_ID=

# Server/Edge Function secrets - never expose in frontend
SUPABASE_SECRET_KEY=

# LINE Login channel "Login Cat Hotel" > Basic settings > Channel ID
# Used as client_id when verifying LIFF ID tokens server-side
LINE_LOGIN_CHANNEL_ID=

# Messaging API channel "LOEI CAT HOTEL" > Basic settings > Channel secret
# Used to verify webhook signatures
LINE_CHANNEL_SECRET=

# Messaging API channel "LOEI CAT HOTEL" > Messaging API > long-lived token
# Used for push / reply / rich menu
LINE_CHANNEL_ACCESS_TOKEN=

PAYMENT_WEBHOOK_SECRET=

# OpenAI server configuration
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_MODEL=
AI_ENABLED=false

# Application
PUBLIC_APP_URL=http://localhost:3000
